{
  "compilerOptions": {
    "target": "ES2017", "module": "CommonJS", "moduleResolution": "Node",
    "jsx": "react-jsx", "esModuleInterop": true, "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "strict": true, "skipLibCheck": true, "noImplicitAny": false,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "config"]
}
