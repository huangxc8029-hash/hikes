# Supabase project settings
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
ROUTE_COVER_BUCKET=route-covers

# Vercel runtime: use Supabase shared transaction pooler (port 6543)
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Public origin, no trailing slash. Use your custom domain in production.
PUBLIC_BASE_URL=https://www.your-domain.com
JWT_SECRET=replace-with-a-long-random-string

# Never set ALLOW_DEV_LOGIN in production.

# Email verification (required for password registration in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=
MAIL_FROM_NAME=到此一游
PUBLIC_BASE_URL=https://your-domain.example
